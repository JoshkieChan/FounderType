# Public build-time configuration (safe to include in the client bundle).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_publishable_or_anon_key
EXPO_PUBLIC_HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
# Optional public Sentry DSN; leave empty to disable diagnostics.
EXPO_PUBLIC_SENTRY_DSN=

# Server-only Edge Function secrets. Set with Supabase, not Expo.
HCAPTCHA_SECRET_KEY=your_hcaptcha_secret
HCAPTCHA_SITE_KEY=your_hcaptcha_site_key
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL=noreply@yourdomain.com
RESEND_FROM_NAME=FounderType
# Explicit recipient allowlist; email stays disabled when empty.
RECEIPT_EMAIL_ALLOWLIST=
# SUPABASE_URL, SUPABASE_ANON_KEY and SUPABASE_SERVICE_ROLE_KEY are supplied by Supabase.

# Optional CI/native source-map upload credentials (never EXPO_PUBLIC_*).
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your_sentry_organization
SENTRY_PROJECT=your_sentry_project
