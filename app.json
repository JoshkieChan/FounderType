{
  "expo": {
    "name": "FounderType",
    "slug": "foundertype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/foundertype-icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "foundertype",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foundertype.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.foundertype.app",
      "versionCode": 1,
      "permissions": ["INTERNET"]
    },
    "web": {
      "favicon": "./assets/foundertype-icon.png",
      "bundler": "metro",
      "output": "single"
    },
    "description": "FounderType identifies why you keep stopping, puts your next commitment on record publicly, and keeps the record honest for 30 days.",
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "foundertype-mobile",
          "organization": "foundertype"
        }
      ],
      "expo-font",
      "expo-asset"
    ]
  }
}
