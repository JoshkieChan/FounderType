{
  "expo": {
    "name": "FounderType",
    "slug": "foundertype",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/foundertype-icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.foundertype.app",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Allow camera for profile pictures",
        "NSPhotoLibraryUsageDescription": "Allow photo library for profile pictures"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.foundertype.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "webpack"
    },
    "description": "Public accountability for founders who finish what they start. Post 30-day commitments, track daily progress, and build consistency with community support.",
    "plugins": [
      "@sentry/react-native",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "foundertype"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "foundertype-project-id"
      }
    }
  }
}
